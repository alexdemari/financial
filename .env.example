# IBKR Connection (IB Gateway / TWS)
# IB Gateway must be running on Windows; WSL2 connects via the default route IP.
# Leave blank to let ibkr-* recipes auto-detect the WSL2 host IP.
IBKR_HOST=
IBKR_PORT=7496

# IBKR Flex Web Service
# Required for: just ibkr-flex-fetch, just ibkr-trades-daily
# Setup: Client Portal → Settings → Account Settings → Flex Web Service
IBKR_FLEX_TOKEN=
# Setup: Client Portal → Performance & Reports → Flex Queries → ℹ️ icon → Query ID
IBKR_FLEX_QUERY_ID=

# Required for: just ibkr-cash-fetch, just ibkr-flex-sync
# Separate Flex Query configured with Cash Transactions (Deposits/Withdrawals,
# Broker Interest, Broker Fees, Dividends) + Change in NAV sections, XML format.
# Reuses IBKR_FLEX_TOKEN above.
IBKR_FLEX_QUERY_ID_CASH=

# LLM Providers
# Required for: just daily-report-llm
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Binance Spot + Simple Earn read-only API credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=
